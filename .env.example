# Optional server-only key for Workable and Wellfound search.
# Copy this file to .env.local, set the key, and restart Vite.
BRAVE_SEARCH_API_KEY=

# Set both to enable cloud accounts and private workspace storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional authenticated AI profile extraction. Both settings stay server-side.
GEMINI_API_KEY=
GEMINI_MODEL=
